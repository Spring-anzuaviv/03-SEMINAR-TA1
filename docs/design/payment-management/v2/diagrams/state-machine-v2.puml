@startuml state-machine-v2
title Vòng đời Bảng thanh toán và hồ sơ điều chỉnh – v2
' Phiên bản: v2 | Đầu vào: SYS-US-01..05 v2, seq-us-*-v2.puml, 02/03 v2 | Prompt: P-37
' Mục đích: vòng đời của hai loại bản ghi, điều kiện chuyển và audit
' Phạm vi: US-PAY-01..05, PAY-01..08, NFR-PAY-01
' Nguồn: TA-SPEC §3–6; TA-PDF tr.1–3; SYS-US v2 và xác nhận nhóm P-37
' Trạng thái: Design Pending Approval

skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #526578
skinparam state {
  BackgroundColor #EFF6FC
  BorderColor #526578
}

state "Bảng thanh toán" as SheetLifecycle {
  state Draft
  state PendingApproval
  state Rejected
  state Approved
  state Cancelled

  [*] --> Draft : create [NVKD phụ trách, nguồn và kỳ hợp lệ]\n/ lưu bảng, ghi audit
  Draft : update, reloadSource [NVKD phụ trách]
  Draft : Lưu ghi chú hoặc tính lại từ nguồn, ghi audit
  Draft --> PendingApproval : submit [nguồn hợp lệ, đủ dịch vụ, tổng ≥ 0]\n/ tăng số lần trình, ghi audit
  PendingApproval : resendSubmissionNotifications
  PendingApproval : Gửi lại trên lần trình hiện tại
  PendingApproval --> Approved : approve [đúng quyền, khác người lập, nguồn hợp lệ]\n/ ghi audit
  PendingApproval --> Rejected : reject [đúng quyền, khác người lập, có lý do ≤ 500 từ]\n/ lưu lý do, ghi audit
  Rejected -up-> Draft : reopen [NVKD phụ trách bấm Chỉnh sửa]\n/ giữ lý do, ghi audit
  Draft --> Cancelled : cancel [NVKD phụ trách, có lý do]\n/ lưu lý do, ghi audit
  Cancelled --> [*]

  note right of Approved
    Bảng gốc và số liệu gốc giữ nguyên.
    Hồ sơ điều chỉnh có vòng đời riêng.
  end note
}

state "Hồ sơ điều chỉnh" as AdjustmentLifecycle {
  state "Pending\nChờ duyệt" as PendingAdjustment
  state "Approved\nĐã duyệt" as ApprovedAdjustment
  state "Declined\nBị từ chối" as DeclinedAdjustment

  [*] --> PendingAdjustment : adjust [KTT, bảng gốc Approved, biên bản hợp lệ,\nthay đổi có lý do, chưa có hồ sơ chờ duyệt]\n/ lưu đề xuất, ghi audit
  PendingAdjustment --> ApprovedAdjustment : approveAdjustment [GĐKD khác người lập hồ sơ]\n/ ghi audit, áp số liệu hiệu lực sau commit
  PendingAdjustment --> DeclinedAdjustment : declineAdjustment [GĐKD khác người lập hồ sơ, có lý do]\n/ lưu lý do, ghi audit
}

legend bottom
  Thẩm quyền bảng: tổng đã lưu gồm GTGT ≥ 500 triệu đồng là GĐKD, dưới ngưỡng là KTT.
  Mọi hồ sơ điều chỉnh do GĐKD xử lý. Chỉ hồ sơ đã duyệt làm đổi số liệu hiệu lực.
  Điều kiện đầy đủ và ghi dữ liệu cùng audit xem 03-detailed-design-v2.md.
endlegend
@enduml
