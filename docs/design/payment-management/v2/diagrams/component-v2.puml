@startuml component-v2
title Kiến trúc module Bảng thanh toán – v2
' Phiên bản: v2 | Đầu vào: SYS-US-01..05 v2, seq-us-*-v2.puml, src/Qtkd.Api/ | Prompt: P-37
' Mục đích: ranh giới module, tích hợp chỉ đọc và lưu trữ nhất quán
' Phạm vi: US-PAY-01..05, PAY-01..08, NFR-PAY-01/02
' Nguồn: TA-SPEC §1–6; TA-PDF tr.1–3; SYS-US v2 và xác nhận nhóm P-37
' Trạng thái: Design Pending Approval

skinparam defaultFontName Arial
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #526578
skinparam componentBackgroundColor #EFF6FC
skinparam interfaceBackgroundColor #FFFFFF

component "Giao diện Bảng thanh toán" as UI <<TO-BE>>

package "Qtkd.Api / ASP.NET Core Minimal API" {
  package "Bảng thanh toán" #F4F9FE {
    component "PaymentController\nCổng API và xác thực" as API
    component "PaymentService\nLập, sửa, trình, gửi lại, hủy" as Payment
    component "PaymentApprovalService\nDuyệt, từ chối, mở lại" as Approval
    component "PaymentAdjustmentService\nLập và xử lý hồ sơ" as Adjustment

    component "IPaymentRepository · IAdjustmentRepository\nIUnitOfWork · IAuditLog" as Persistence
    component "Điều phối thông báo\ntheo lần trình và người nhận" as Notifications

    interface "IContractReader\nIPriceReader\nIQuantityReader" as Sources
    interface "IUserDirectory\nINotifier" as NotifyPorts
  }

  component "ContractService\nDemo trong bộ nhớ" as ContractDemo <<AS-IS>> #F2F2F2
}

component "Bảng giá · Sản lượng\nNguồn chỉ đọc" as PriceQuantity <<TO-BE>>
component "Danh bạ người dùng\nThông báo trong hệ thống" as UserNotify <<TO-BE>>
database "PaymentDatabase\nBảng, lần trình, hồ sơ, audit" as DB <<TO-BE>>

UI --> API : thao tác nghiệp vụ
API --> Payment
API --> Approval
API --> Adjustment

Payment ..> Sources : lập, tải lại, trình, phân công
Approval ..> Sources : duyệt, phân công
Sources ..> ContractDemo : adapter hợp đồng
Sources ..> PriceQuantity : adapter giá / sản lượng

Payment --> Persistence
Approval --> Persistence
Adjustment --> Persistence
Persistence --> DB : dữ liệu và audit cùng giao dịch

Payment --> Notifications : trình, gửi lại
Approval --> Notifications : kết quả duyệt / từ chối
Notifications ..> NotifyPorts
NotifyPorts ..> UserNotify

legend bottom
  Package Bảng thanh toán và các thành phần <<TO-BE>> là thiết kế đề xuất.
  <<AS-IS>> là demo hợp đồng hiện có; adapter cần bổ sung dữ liệu hợp đồng theo SYS-US v2.
endlegend
@enduml
